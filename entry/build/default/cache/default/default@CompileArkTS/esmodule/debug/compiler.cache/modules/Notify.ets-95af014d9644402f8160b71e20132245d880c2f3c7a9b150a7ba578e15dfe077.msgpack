    }
    get tweets() {
        return this.__tweets.get();
    }
    set tweets(newValue) {
        this.__tweets.set(newValue);
    }
    get handle() {
        return this.__handle.get();
    }
    set handle(newValue) {
        this.__handle.set(newValue);
    }
    async loadLive() {
        try {
            const saved = await TokenStore.loadHandle(getContext(this));
            this.handle = saved;
            if (saved !== '') {
                const live = await WebTimeline.fetchByHandle(saved);
                this.tweets = live.filter((t) => t.content.indexOf('@') >= 0);
            }
            else {
                this.tweets = [];
            }
        }
        catch (e) {
            this.tweets = [];
