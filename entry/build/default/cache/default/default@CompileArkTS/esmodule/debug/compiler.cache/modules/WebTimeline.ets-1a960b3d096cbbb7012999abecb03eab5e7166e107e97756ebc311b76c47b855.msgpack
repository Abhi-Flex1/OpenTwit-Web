            if (pStart < 0) {
                return undefined;
            }
            let gt = html.indexOf('>', pStart);
            let pEnd = html.indexOf('</p>', gt);
            if (gt < 0 || pEnd < 0) {
                return undefined;
            }
            let text = WebTimeline.stripTags(html.substring(gt + 1, pEnd));
            if (text === '') {
                return undefined;
            }
            let name = handle;
            if (rec['author_name']) {
