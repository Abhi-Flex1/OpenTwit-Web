    }
    get handle() {
        return this.__handle.get();
    }
    set handle(newValue) {
        this.__handle.set(newValue);
    }
    get tweetId() {
        return this.__tweetId.get();
    }
    set tweetId(newValue) {
        this.__tweetId.set(newValue);
    }
    get tweet() {
        return this.__tweet.get();
