    async searchUser(value) {
        try {
            this.foundUser = await HandleLookup.lookup(value);
        }
        catch (e) {
            this.foundUser = undefined;
        }
    }
    async loadLive() {
        try {
            const saved = await TokenStore.loadHandle(getContext(this));
            this.handle = saved;
            if (saved !== '') {
                this.tweets = await WebTimeline.fetchByHandle(saved);
            }
            else {
                this.tweets = [];
            }
        }
        catch (e) {
            this.tweets = [];
        }
    }
    aboutToAppear() {
        this.loadLive();
    }
    getForYou() {
        const q = this.query.trim().toLowerCase();
        if (q === '') {
            return this.tweets;
        }
        return this.tweets.filter((t) => {
            return t.content.toLowerCase().indexOf(q) >= 0 || t.handle.toLowerCase().indexOf(q) >= 0;
        });
    }
    getTrending() {
        const q = this.query.trim().toLowerCase();
        return this.tweets.filter((t) => {
            const isTrend = t.content.indexOf('#') >= 0;
            if (!isTrend) {
                return false;
            }
            if (q === '') {
                return true;
            }
            return t.content.toLowerCase().indexOf(q) >= 0 || t.handle.toLowerCase().indexOf(q) >= 0;
        });
    }
