{
	"app": {
		"bundleName": "com.example.opentwit",
		"vendor": "example",
		"versionCode": 1,
		"versionName": "1.0.0",
		"minAPIVersion": 24,
		"icon": "$media:app_icon",
		"label": "$string:app_name",
		"apiReleaseType": "Release",
		"compileSdkVersion": "6.1.1.125",
		"targetAPIVersion": 24,
		"compileSdkType": "OpenHarmony",
		"targetMinorAPIVersion": 0,
		"targetPatchAPIVersion": 0,
		"appEnvironments": [],
		"bundleType": "app",
		"buildMode": "debug",
		"debug": true
	},
	"module": {
		"name": "entry",
		"type": "entry",
		"description": "OpenTwit entry module",
		"mainElement": "EntryAbility",
		"deviceTypes": [
			"default",
			"tablet"
		],
		"deliveryWithInstall": true,
		"installationFree": false,
		"pages": "$profile:main_pages",
		"abilities": [
			{
				"name": "EntryAbility",
				"srcEntry": "./ets/entryability/EntryAbility.ets",
				"description": "OpenTwit entry ability",
				"icon": "$media:app_icon",
				"label": "$string:app_name",
				"startWindowIcon": "$media:app_icon",
				"startWindowBackground": "$color:hw_bg_light",
				"exported": true,
				"skills": [
					{
						"entities": [
							"entity.system.home"
						],
						"actions": [
							"action.system.home"
						]
					}
				]
			}
		],
		"requestPermissions": [
			{
				"name": "ohos.permission.INTERNET",
				"reason": "$string:internet_reason"
			}
		],
		"packageName": "entry"
	}
}
